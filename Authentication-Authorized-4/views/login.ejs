<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login User</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-3xl mb-5">Login User</h3>

        <form method="post" action="/login">
            <input
                class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none block mb-4"
                type="email"
                name="email"
                placeholder="Email"
                required
            >

            <input
                class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none block mb-4"
                type="password"
                name="password"
                placeholder="Password"
                required
            >

            <input
                class="px-5 py-2 rounded-md bg-green-500 cursor-pointer"
                type="submit"
                value="Login"
            >
        </form>
    </div>
</body>
</html>